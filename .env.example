# Banco local. No Docker Compose, use file:/data/app.db
DATABASE_URL="file:../data/app.db"

# URL pública apenas para callbacks locais de OAuth
APP_URL="http://127.0.0.1:3000"

# Opcional: gere com `openssl rand -base64 32`. Necessária para armazenar tokens OAuth.
APP_ENCRYPTION_KEY=""

# IA opcional. Uma assinatura do ChatGPT não inclui créditos de API.
OPENAI_API_KEY=""
OPENAI_MODEL=""
OPENAI_MONTHLY_REQUEST_LIMIT="30"

# Gmail opcional: cliente OAuth do tipo Aplicação Web.
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://127.0.0.1:3000/api/integrations/gmail/callback"

# Worker
WORKER_INTERVAL_MS="300000"
